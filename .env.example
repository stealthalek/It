PORT=3000
JWT_SECRET=change-this-secret-in-production
DEFAULT_ADMIN_EMAIL=admin@ticketing.local
DEFAULT_ADMIN_PASSWORD=Admin123!

# Optional: leave unset to use a local SQLite file (data/ticketing.db).
# Set both to use a persistent Turso database instead (see README).
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Optional: enable Google/Microsoft sign-in (see README for setup steps).
# GOOGLE_CLIENT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT_ID=common

# Optional: send an email to the customer when their ticket is resolved (see README).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: move ticket attachments to S3-compatible storage instead of the database (see README).
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
